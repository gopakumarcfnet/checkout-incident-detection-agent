      "id": "b875ad42-a25f-400d-9742-a46f7590ca5d",
      "name": "Read Cart Events",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        720,
        224
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Business thresholds (document these in your submission)\nconst HIGH_CART_VALUE = 500;\nconst MOBILE_FAILURE_THRESHOLD = 2;\n\n// Timestamps are Excel/Sheets serial numbers (days since 1899-12-30)\nfunction toSerial(v) {\n  if (v === null || v === undefined || v === '') return null;\n  if (typeof v === 'number') return v;\n  const n = Number(v);\n  if (!isNaN(n)) return n;\n  const ms = Date.parse(v);\n  if (isNaN(ms)) return null;\n  return ms / 86400000 + 25569;\n}\nfunction serialToIso(s) {\n  return new Date(Math.round((s - 25569) * 86400000)).toISOString();\n}\nfunction normRate(r) {\n  const raw = String(r === undefined || r === null ? '' : r);\n  let n = Number(raw.replace('%', '').trim());\n  if (raw.trim() === '' || isNaN(n)) return null;\n  if (raw.includes('%') || n > 1) n = n / 100;\n  return n;\n}\nfunction pct(x) { return (x * 100).toFixed(1) + \"%\"; }\n\n// 1. State: last processed timestamp\nconst stateRow = $('Read State').all().map(i => i.json).find(r => String(r.key || '').trim() === 'last_processed_timestamp');\nconst lastTs = toSerial(stateRow ? stateRow.value : null) || 0;\n\n// 2. Baseline metrics per step\nconst baseline = {};\nfor (const item of $('Read Baseline Metrics').all()) {\n  const step = String(item.json.checkout_step || '').trim().toUpperCase();\n  if (step) baseline[step] = normRate(item.json.baseline_rate);\n}\n\n// 3. Only events newer than the stored state\nconst events = $('Read Cart Events').all()\n  .map(i => ({\n    ts: toSerial(i.json.timestamp),\n    step: String(i.json.checkout_step || '').trim().toUpperCase(),\n    device: String(i.json.device || '').trim().toUpperCase(),\n    value: Number(String(i.json.cart_value === undefined || i.json.cart_value === null ? '' : i.json.cart_value).replace(/[^0-9.\\-]/g, '')) || 0,\n  }))\n  .filter(e => e.ts !== null && e.ts > lastTs)\n  .sort((a, b) => a.ts - b.ts);\n\n// Nothing new: stop here (no command, no webhook, state unchanged)\nif (events.length === 0) return [];\n\n// 4. Metrics\nconst total = events.length;\nconst stepCounts = {};\nfor (const e of events) stepCounts[e.step] = (stepCounts[e.step] || 0) + 1;\nconst stepsOverBaseline = Object.keys(stepCounts).filter(s => baseline[s] !== undefined && baseline[s] !== null && stepCounts[s] / total > baseline[s]);\nconst paymentEvents = events.filter(e => e.step === 'PAYMENT');\nconst highValueEvents = events.filter(e => e.value >= HIGH_CART_VALUE);\nconst mobileEvents = events.filter(e => e.device === 'MOBILE');\nconst maxValue = Math.max(...events.map(e => e.value));\n\n// 5. Rules -> severity\nconst reasons = [];\nif (paymentEvents.length > 0) reasons.push(paymentEvents.length + ' failure(s) at PAYMENT step (revenue impact)');\nif (highValueEvents.length > 0) reasons.push(highValueEvents.length + ' high-value cart(s) >= ' + HIGH_CART_VALUE + ' (max ' + maxValue + ')');\nif (stepsOverBaseline.length > 0) reasons.push('failure rate above baseline: ' + stepsOverBaseline.map(s => s + ' ' + pct(stepCounts[s] / total) + ' vs ' + pct(baseline[s])).join(', '));\nif (mobileEvents.length >= MOBILE_FAILURE_THRESHOLD) reasons.push(mobileEvents.length + ' MOBILE failures (possible app bug)');\nconst severity = reasons.length > 0 ? 'HIGH' : 'LOW';\nconst action = severity === 'HIGH' ? 'ALERT' : 'LOG';\nconst reason = severity === 'HIGH'\n  ? 'Processed ' + total + ' new event(s): ' + reasons.join('; ')\n  : 'Processed ' + total + ' new event(s): low value, isolated incident, no payment failure, no rate above baseline';\n\n// 6. Primary event that represents this run\nconst byValue = (a, b) => (b.value - a.value) || (b.ts - a.ts);\nconst primary = paymentEvents.filter(e => e.value >= HIGH_CART_VALUE).sort(byValue)[0]\n  || paymentEvents.slice().sort(byValue)[0]\n  || highValueEvents.slice().sort(byValue)[0]\n  || events.slice().sort(byValue)[0];\n\nconst command = {\n  command_id: 'CMD-' + $execution.id + '-' + Date.now(),\n  action: action,\n  severity: severity,\n  reason: reason,\n  checkout_step: primary.step,\n  cart_value: primary.value,\n  device: primary.device,\n  baseline_rate: baseline[primary.step] === undefined || baseline[primary.step] === null ? '' : baseline[primary.step],\n  timestamp: serialToIso(primary.ts),\n};\n\nreturn [{ json: Object.assign({}, command, {\n  events_processed: total,\n  new_last_processed_timestamp: events[events.length - 1].ts,\n  webhook_payload: command,\n}) }];"
      },
